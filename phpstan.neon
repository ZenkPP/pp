parameters:
    level: 5

    paths:
        - assets
        - commands
        - config
        - controllers
        - mail
        - migrations
        - modules
        - widgets

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    ignoreErrors:
        -
            message: '#Call to an undefined static method Yii::t\(\).#'
            path: modules/orders/services/OrderCsvExporter.php


    tmpDir: %currentWorkingDirectory%/runtime
