parameters:
    level: 5

    paths:
        - config
        - migrations
        - modules

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    bootstrapFiles:
        - config/phpstan-bootstrap.php

    tmpDir: %currentWorkingDirectory%/runtime
